#! Random number generation and random selection
# Return a random boolean.
bool()
# Return random bytes.
bytes(count)
# Return true with the given probability.
chance(probability)
# Choose one element from a sequence.
choice(seq)
# Choose several elements from a sequence.
choices(seq, count)
# Return a random floating point number.
float(low?, high?)
# Return a random integer in a range.
int(low, high)
# Generate the next random value.
next()
# Return a random floating point number between 0 and 1.
random()
# Return a random integer range.
range(low, high)
# Sample elements from a sequence without replacement.
sample(seq, count)
# Seed the random number generator.
seed(value)
# Shuffle a sequence in place.
shuffle(seq)
# Return a random string.
str(length?)
# Return a random value from a collection.
value(values)
# Choose an element using weights.
weighted(values, weights)
# Return a random UUID string.
uuid()
