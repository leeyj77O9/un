#! Built-in functions available in every scope
# Return the number of elements or the length of a value.
len(value)
# Return the runtime type of a value.
type(value)
# Return the hash value of a value.
hash(value)
# Return a string representation of a value.
repr(value)
# Exit the program with the given status code.
exit(code?)
# Throw an exception.
throw(message, name?)
# Throw an exception when the condition is true.
throw_if(condition, message, name?)
# Throw an exception when the condition is false.
throw_unless(condition, message, name?)
