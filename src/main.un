class A
	fn __init__(n)
		self.n = n
	fn bark()
		-> `{type(self)}, [base 1], [{self.n}]`
class B
	fn __init__(m)
		self.m = m
	fn bark()
		-> `{type(self)}, [base 2], [{self.m}]`

class C : A, B
	fn bark()
		-> `{type(self)}, [child], [{self.n}], [{none?.m}]`

use io

io.write(C(3).bark(), A(1).bark(), B(1).bark(), sep='\n')
