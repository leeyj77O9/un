use io

fn may_fail(x)
    if x < 0
        -> throw("negative")
    -> x * 2

fn caller_ok()
    v = may_fail(5)?
    -> v + 1

fn caller_fail()
    v = may_fail(-1)?
    -> v + 1

# ok path
io.write(caller_ok())  # 11

# fail path returns Err via ? -> caller propagates Err, call site throws Error, need try
try
    r = caller_fail()
    io.write("should not reach")
catch e
    io.write(`caller_fail caught: {e}`)

# top-level ?
try
    x = may_fail(-1)?
    io.write("should not reach")
catch e
    io.write(`caught top-level ?: {e}`)

# chaining ?
fn inner(x)
    -> may_fail(x)?

fn outer(x)
    -> inner(x)? + 10

io.write(outer(5))   # 20
try
    io.write(outer(-1))
catch e
    io.write(`outer -1 caught: {e}`)

# ? with normal value (no error) should just unwrap
fn get_val(x)
    -> x

io.write(get_val(42)?)  # 42

io.write("question tests done")
