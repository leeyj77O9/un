use io

fn check(actual, expected, label)
    if actual != expected
        panic(`[FAIL] {label}: expected {expected}, got {actual}`)

class A
    fn name_a()
        -> "a"

class B
    fn name_b()
        -> "b"

class C: A, B
    fn name_c()
        -> "c"

c = C()
check(c is C, true, "instance is own class")
check(c is A, true, "instance is first base")
check(c is B, true, "instance is second base")
check(c is not B, false, "is not second base")
check(c.name_a(), "a", "first base method")
check(c.name_c(), "c", "own method")

class D: A, B
    fn __init__()
        self.ready = true

d = D()
check(d is D, true, "init instance is own class")
check(d is A, true, "init instance is first base")
check(d is B, true, "init instance is second base")
check(d.ready, true, "init ran")

class E: A
e = E()
check(e is E, true, "single child is own class")
check(e is A, true, "single child is base")
check(e.name_a(), "a", "single inherited method")

class P(x, y)
class Q: P

q = Q(1, 2)
check(q is Q, true, "derived struct is own class")
check(q is P, true, "derived struct is base")
check(q.x, 1, "derived struct field x")
check(q.y, 2, "derived struct field y")

io.write("all inheritance is tests passed!")
