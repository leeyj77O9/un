use io

# `go`/`wait` in a function that is never called must still be rejected by a
# plain build: native executables have no async runtime and must not silently
# drop the construct. `un run` is not invoked on this fixture.
fn worker() -> int
    x = go 1
    -> wait x

fn main() -> int
    io.write(1)
    -> 0

main()
