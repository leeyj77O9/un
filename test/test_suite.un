use io
use iter
use test.assert as assert

# ============================================================
# Un Language Test Suite — 정상 동작 판단용
# 실행: dotnet run -c Release -- run test/test_suite.un
# ============================================================

io.write("=== literals ===")
assert.assert_eq(1, 1, "int literal")
assert.assert_eq(3.14, 3.14, "float literal")
assert.assert_true(true, "bool true")
assert.assert_eq("hello", "hello", "str literal")
assert.assert_eq(none, none, "none literal")

io.write("\n=== operators ===")
assert.assert_eq(1 + 2, 3, "add")
assert.assert_eq(5 - 3, 2, "sub")
assert.assert_eq(3 * 4, 12, "mul")
assert.assert_eq(7 // 2, 3, "idiv int")
assert.assert_eq(7.5 // 2.5, 3, "idiv float")
assert.assert_eq(7 % 3, 1, "mod")
assert.assert_eq(2 ** 3, 8, "pow")
assert.assert_eq((1 + 2) * 3, 9, "grouping")
assert.assert_true(1 < 2, "lt")
assert.assert_true(2 > 1, "gt")
assert.assert_true(1 <= 1, "le")
assert.assert_true(2 >= 2, "ge")
assert.assert_true(not false, "not")
assert.assert_true(true and true, "and")
assert.assert_true(true or false, "or")

# compound assignment
cx = 10
cx += 5
assert.assert_eq(cx, 15, "compound +=")
cx <<= 3
assert.assert_eq(cx, 120, "compound <<=")
acc = 0
for v in [1,2,3]
    acc += v
assert.assert_eq(acc, 6, "compound in loop")
nv = none
nv ??= 7
assert.assert_eq(nv, 7, "compound ??=")

# optional chaining
maybe = none
assert.assert_eq(maybe?.value, none, "optional property")
assert.assert_eq(maybe?.value.more, none, "optional chain")
assert.assert_eq(maybe?.call(), none, "optional call")

# assignment as an expression
ex := 10
assert.assert_eq(ex, 10, "colon assignment")
ey := ex := 4
assert.assert_eq(ey, 4, "colon assignment value")
assert.assert_eq(ex, 4, "colon assignment target")
assert.assert_eq((ez := 2) + 3, 5, "colon assignment expression")

io.write("\n=== tuple / destructuring ===")
t = (1, 2)
assert.assert_eq(t[0], 1, "tuple index 0")
assert.assert_eq(t[1], 2, "tuple index 1")
x1, y1 = t
assert.assert_eq(x1, 1, "destructure a")
assert.assert_eq(y1, 2, "destructure b")
assert.assert_true((1,2) == (1,2), "tuple eq true")
assert.assert_true((1,2) != (1,3), "tuple eq false")
assert.assert_true(2 in (1,2,3), "tuple in true")
assert.assert_true(not (5 in (1,2,3)), "tuple in false")
a_typed: list[int] = [1,2,3]
assert.assert_eq(len(a_typed), 3, "typed var list[int]")

io.write("\n=== list ===")
lst = [1,2,3,4]
assert.assert_eq(lst[0], 1, "list index")
assert.assert_eq(lst[3], 4, "list index 3")
lst[1] = 99
assert.assert_eq(lst[1], 99, "list set")
sl = [1,2,3,4]
sl[1:3] = [9]
assert.assert_eq(sl, [1,9,4], "slice assignment")
lst2 = [1,3,5,7,9]
assert.assert_eq(lst2.lower_bound(5), 2, "lower_bound")
assert.assert_eq(lst2.upper_bound(5), 3, "upper_bound")
# heap
h = []
h.hpush(5)
h.hpush(3)
h.hpush(7)
h.hpush(1)
assert.assert_eq(h.hpop(), 1, "hpop 1")
assert.assert_eq(h.hpop(), 3, "hpop 2")

io.write("\n=== dict / set / json ===")
d = {"name": "un", "age": 20}
assert.assert_eq(d["name"], "un", "dict get")
d2: dict[str, int] = {"x": 10}
assert.assert_eq(d2["x"], 10, "typed dict")
assert.assert_eq(d2.get("y", default_value=99), 99, "dict get default_value")
s = set(1, 2, 3)
assert.assert_true(s.contains(2), "set contains")

io.write("\n=== string (snake_case) ===")
s = "hello world"
assert.assert_eq(s.index_of("world"), 6, "index_of")
assert.assert_true(s.contains("world"), "contains")
assert.assert_true(s.starts_with("hello"), "starts_with")
assert.assert_true(s.ends_with("world"), "ends_with")
assert.assert_eq("a,b,c".split(","), ["a","b","c"], "split")
assert.assert_eq("  hi  ".trim(" "), "hi", "trim")
assert.assert_eq(",".join(["a","b","c"]), "a,b,c", "join")
assert.assert_eq("hi".center(6, "-"), "--hi--", "center")
assert.assert_eq("hi".left(5, "-"), "hi---", "left")
assert.assert_eq("hi".right(5, "-"), "---hi", "right")
assert.assert_eq("hello world".replace(old_value="world", new_value="un"), "hello un", "replace")
assert.assert_eq(s.find(sub_str="world"), 6, "find")
assert.assert_eq(s.find(sub_str="missing"), -1, "find missing")

io.write("\n=== control flow ===")
# if
x = 10
if x > 5
    assert.assert_true(true, "if true")
else
    assert.assert_true(false, "if true else")

# for
sum = 0
for v in [1,2,3]
    sum += v
assert.assert_eq(sum, 6, "for sum")

# while
n = 0
while n < 3
    n += 1
assert.assert_eq(n, 3, "while")

# match
res = match 1 {
    0 -> "zero",
    1 -> "one",
    _ -> "other",
}
assert.assert_eq(res, "one", "match")

# break/skip
n = 0
while true
    if n == 3
        break
    n += 1
assert.assert_eq(n, 3, "break")

skipped = []
for v in [0,1,2,3,4]
    if v == 2
        skip
    skipped.add(v)
assert.assert_eq(skipped, [0,1,3,4], "skip")

io.write("\n=== functions ===")
fn add(a, b)
    -> a + b
assert.assert_eq(add(3,4), 7, "fn add")

fn greet(name = "world")
    -> `hello {name}`
assert.assert_eq(greet(), "hello world", "default arg")
assert.assert_eq(greet("un"), "hello un", "default arg override")

fn fib(n)
    if n < 2
        -> 1
    -> fib(n-1) + fib(n-2)
assert.assert_eq(fib(5), 8, "recursion fib")

mul = fn(a, b) -> a * b
assert.assert_eq(mul(6,7), 42, "lambda")

# generic typed params
fn foo(a: list[int], b: dict[str, int], c: int | str)
    -> 42
assert.assert_eq(foo([1], {"x":1}, 5), 42, "generic params")

io.write("\n=== classes / structs ===")
class Point(x, y)
    fn len()
        -> self.x + self.y

p = Point(10, 20)
assert.assert_eq(p?.x, 10, "optional property on object")
assert.assert_eq(p.x, 10, "class field x")
assert.assert_eq(p.y, 20, "class field y")
assert.assert_eq(p.len(), 30, "class method")
p2 = Point(10, 20)
assert.assert_true(p == p2, "stru eq true")
p3 = Point(10, 30)
assert.assert_true(p != p3, "stru eq false")

class Child: Point
    fn greet()
        -> `hi {self.x}`

ch = Child(5, 6)
assert.assert_eq(ch.x, 5, "inherit field")
assert.assert_true(ch is Child, "is own class")
assert.assert_true(ch is Point, "is base class")

class BaseA
class BaseB
class Multi: BaseA, BaseB
m = Multi()
assert.assert_true(m is Multi, "multi is own class")
assert.assert_true(m is BaseA, "multi is first base")
assert.assert_true(m is BaseB, "multi is second base")

io.write("\n=== iter / range ===")
r = iter.range(0, 3)
lst_r = []
for v in r
    lst_r.add(v)
assert.assert_eq(lst_r, [0,1,2], "range")
assert.assert_eq(iter.array(0, 3), [0,0,0], "iter.array")
assert.assert_eq(iter.array("x", [2]), ["x","x"], "iter.array value")

io.write("\n=== error handling ===")
# type mismatch should return Err and be catchable via panic path is tested externally

# summary
assert.summary()
io.write("all suite passed")
