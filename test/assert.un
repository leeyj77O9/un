use io
use math

# Shared assertion module for the Un test suite.
# 사용: use test.assert as assert, 마지막에 assert.summary() 호출.
state = {"passed": 0, "failed": 0}

fn passed()
    -> state["passed"]

fn failed()
    -> state["failed"]

fn assert_true(cond, msg)
    if cond
        state["passed"] += 1
    else
        state["failed"] += 1
        io.write(`[FAIL] {msg} | expected true, got false`)

fn assert_false(cond, msg)
    if not cond
        state["passed"] += 1
    else
        state["failed"] += 1
        io.write(`[FAIL] {msg} | expected false, got true`)

fn assert_eq(a, b, msg)
    if a == b
        state["passed"] += 1
    else
        state["failed"] += 1
        io.write(`[FAIL] {msg} | expected {b}, got {a}`)

fn assert_neq(a, b, msg)
    if a != b
        state["passed"] += 1
    else
        state["failed"] += 1
        io.write(`[FAIL] {msg} | expected not {b}`)

# float 비교는 반올림 오차를 허용한다.
fn assert_close(a, b, tol, msg)
    if math.abs(a - b) <= tol
        state["passed"] += 1
    else
        state["failed"] += 1
        io.write(`[FAIL] {msg} | expected ~{b} (+-{tol}), got {a}`)

fn assert_type(v, t, msg)
    if v is t
        state["passed"] += 1
    else
        state["failed"] += 1
        io.write(`[FAIL] {msg} | expected type {t}, got {type(v)}`)

fn assert_len(v, n, msg)
    if len(v) == n
        state["passed"] += 1
    else
        state["failed"] += 1
        io.write(`[FAIL] {msg} | expected len {n}, got {len(v)}`)

# f는 0-아규먼트 람다. 예: assert_err(fn() -> 1 / 0, "div by zero")
fn assert_err(f, msg)
    try
        f()
        state["failed"] += 1
        io.write(`[FAIL] {msg} | expected an error, got none`)
    catch e
        state["passed"] += 1

# 에러 메시지 비교. e는 f-string으로 변환해 비교한다.
fn assert_err_eq(f, expected, msg)
    try
        f()
        state["failed"] += 1
        io.write(`[FAIL] {msg} | expected error, got none`)
    catch e
        if `{e}` == expected
            state["passed"] += 1
        else
            state["failed"] += 1
            io.write(`[FAIL] {msg} | expected error '{expected}', got '{e}'`)

fn summary()
    p = state["passed"]
    f = state["failed"]
    io.write(`\n=== Result: {p} passed, {f} failed ===`)
    # panic은 내장 함수가 아니므로 exit로 종료 코드를 전달한다.
    if f > 0
        exit(1)
    -> 0
