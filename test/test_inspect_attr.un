use io
use inspect
use test.assert as assert

s = "hello"
assert.assert_true(inspect.hasattr(s, "split"), "str split")
assert.assert_true(inspect.hasattr(s, "to_upper"), "str to_upper")
assert.assert_false(inspect.hasattr(s, "nonexistent"), "str missing attr")
assert.assert_true(inspect.hasattr([1, 2], "add"), "list add")

assert.summary()
io.write("all inspect tests passed!")
