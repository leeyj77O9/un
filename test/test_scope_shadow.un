use test.assert as assert
use io

# 1. 기본 섀도잉: 내부 fn에서 외부 변수 가리지 않음
fn outer()
    x = 1
    fn inner()
        x = 2  # 로컬 변수 생성 (SetLocal로 처리되어야 함)
    inner()
    assert.assert_eq(x, 1, "shadow: outer x unchanged")

outer()

# 2. 중첩 섀도잉 여러 레벨
fn level1()
    a = 10
    fn level2()
        a = 20
        fn level3()
            a = 30
        level3()
        assert.assert_eq(a, 20, "shadow: level2 a unchanged")
    level2()
    assert.assert_eq(a, 10, "shadow: level1 a unchanged")

level1()

# 3. 루프 변수 섀도잉
fn loop_shadow()
    i = 100
    for i in [1, 2, 3]
        skip
    assert.assert_eq(i, 100, "shadow: loop variable doesn't leak")

loop_shadow()

# 4. 클로저에서 외부 변수 읽기 (쓰기 아님)
fn closure_read()
    counter = 0
    fn inc()
        counter = counter + 1  # 이건 읽기 + 쓰기 → 새 로컬 생성됨 (현재 동작)
        # 실제 클로저 캡처 테스트는 별도
    inc()
    # 현재 구현에선 counter는 0 유지 (shadowing)
    assert.assert_eq(counter, 0, "shadow: closure write creates local")

closure_read()

# 5. super 키워드는 현재 부분적으로만 지원되므로 생략
io.write("all scope shadow tests passed!")