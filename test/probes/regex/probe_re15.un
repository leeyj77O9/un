use io
use re

fn probe(name, pat, text)
    try
        io.write(name, " | ", `M {re.search(pat, text)}\n`)
    catch e
        io.write(name, " | ", `ERR {e}\n`)

fn rep(name, pat, text, sub)
    try
        io.write(name, " | ", `R {re.replace(pat, text, sub)}\n`)
    catch e
        io.write(name, " | ", `ERR {e}\n`)

fn esc(name, text)
    try
        io.write(name, " | ", `E {re.escape(text)}\n`)
    catch e
        io.write(name, " | ", `ERR {e}\n`)

probe("t01", "{2}a", "a")
probe("t02", "+a", "a")
probe("t03", "?a", "a")
probe("t04", "a*+", "aa")
probe("t05", "a*?+", "aa")
probe("t06", "a{1}?", "aa")
probe("t07", "(a)*{2}", "aa")
probe("t08", "((?m)^b)", "a\nb")
probe("t09", "(a)(?i)B", "aB")
probe("t10", "x(?i)y", "xY")
probe("t11", "(?i:a)bc", "Abc")
probe("t12", "(?i)abc", "ABC")
probe("t13", "a#", "a")
probe("t14", "(?x)a#b", "a")
probe("t15", "\\", "a")
probe("t16", "[a-]", "a-")
probe("t17", "[a-b-c]", "c")
probe("t18", "(?i)", "a")
probe("t19", "((a)(?i)b)B", "aBB")
probe("t20", "(?i)(", "a")
probe("t21", "(?<=^a)b", "ab")
probe("t22", "(?<!a)b", "ab")
probe("t23", "(?>(a))\1", "aa")
probe("t24", "(?i:a)b", "AB")
probe("t25", "(?x)a b #c", "ab")
probe("t26", "a{0,0}b", "b")
probe("t27", "[(]]", "]")
probe("t28", "(?i)[a-z]", "A")
probe("t29", "x(?x:a b)c", "xabc")
probe("t30", "(a)(?i:\1)", "aA")
probe("t31", "a(?i)bc", "aBC")
probe("t32", "abc", "ABC")
probe("t33", "(?i)(?>a)\1", "aA")
probe("t34", "((?i:a)b)B", "aB")
probe("t35", "(?:a)(b)\2", "ab")
probe("t36", "a{2,3}?", "aaa")
probe("t37", "(?<x>a)cd\k<x>", "acd")
probe("t38", "(a){11}", "aaaaaaaaaaa")
probe("t39", "(a)(b)(c)(d)(e)(f)(g)(h)(i)(j)(k)\11", "abcdefghijk")
probe("t40", "(?<x>a)\k<x>", "Aa")

esc("x01", "a-b")
esc("x02", "a]b")
esc("x03", "a~b")
esc("x04", "a&b")
esc("x05", "a'b")
esc("x06", "a\"b")
esc("x07", "a b")
esc("x08", "a\tb")
esc("x09", "a" + chr(11) + "b")
esc("x10", "a_b")
esc("x11", "a/b")
esc("x12", "a:b")
