use io
use re

fn probe(name, pat, text)
    try
        io.write(name, " | ", re.search(pat, text), "\n")
    catch e
        io.write(name, " | ", `ERR {e}`, "\n")

probe("e01", "\\Qa.b\\E+", "a.a.b")
probe("e02", "\\Q\\E", "a")
probe("e03", "\\Qabc", "abc")
probe("e04", "\\E", "a")
probe("e05", "\\C", "ab")
probe("e06", "[\\b]", "a" + chr(8) + "b")
probe("e07", "\\x41", "aA")
probe("e08", "\\x{41}", "aA")
probe("e09", "\\u0041", "aA")
probe("e10", "\\cA", "aA")
probe("e11", "\\d\\2", "ab")
probe("e12", "(?<x>(a)*b)c", "abac")
probe("e13", "(?<=x)", "x")
probe("e14", "(?=)", "x")
probe("e15", "(?!x)y", "y")
probe("e16", "(?>)x", "x")
probe("e17", "(?<x)", "x")
probe("e18", "(?<", "x")
probe("e19", "(?<>a)", "a")
probe("e20", "(?<-a>b)", "b")
probe("e21", "(?<x-a>y)", "y")
probe("e22", "(?<x>a)(?<x-a>b)", "ab")
probe("e23", "(?<x>a)(?<x-a>b)c", "abc")
probe("e24", "(?<x>a)(?<x-a>b)c", "ac")
probe("e25", "a[-b]", "a-b")
probe("e26", "[-()]", "()")
probe("e27", "[a-z&&b-d]", "abc")
probe("e28", "[^a-z]", "A")
probe("e29", "[]a]", "a]")
probe("e30", "[a]]", "a]")
probe("e31", "[.]", ".")
probe("e32", "[\\s]", " a")
probe("e33", "(?x)[ ]", " a")
probe("e34", "(?x)a\\ b", "a b")
probe("e35", "(?x)(?<x>a)b", "ab")
probe("e36", "\\d+", "a12b")
probe("e37", "\\w", "a1")
probe("e38", "(?i)a{2}", "Aa")
probe("e39", "\\p{L}\\p{L}", "ab")
probe("e40", "\\p{L}", "1")
probe("e41", "\\p{IsLatin}", "ab")
probe("e42", "\\p{IsGreek}", "ab")
probe("e43", "\\p{Mark}", "ab")
probe("e44", "\\p{P}", "a-.")
probe("e45", "\\p{S}+", "a+b")
probe("e46", "\\p{Nd}", "a1")
probe("e47", "\\P{Lu}b", "aBb")
probe("e48", "a\\d", "a1b")
probe("e49", "(?i)\\w+", "ABC_1")
