use io
use re

fn t(pat, text)
    -> re.test(pat, text)

# common .NET features
io.write("non-greedy .*?: ", re.search("a.*?b", "axxxb"), "\n")
io.write("possessive a++b: ", re.test("a++b", "aaab"), "\n")
io.write("lookbehind (?<=a)b: ", re.search("(?<=a)b", "ab"), "\n")
io.write("neg lookahead a(?!c): ", re.search("a(?!c)", "ab"), "\n")
io.write("atomic (?>a*)ab: ", re.test("(?>a*)ab", "aaab"), "\n")
io.write("\\B: ", re.search("\\Bb", "ab"), "\n")
io.write("(?i)AB on ab: ", re.search("(?i)AB", "ab"), "\n")
io.write("(?m)^b: ", re.search("(?m)^b", "a\nb"), "\n")
io.write("(?s).{3} on a\nb: ", re.search("(?s)a.{2}", "a\nb"), "\n")
io.write("backref (ab)\\1: ", re.test("(ab)\\1", "abab"), "\n")
io.write("named group (?<n>ab): ", re.groups("(?<n>ab)", "ab"), "\n")
io.write("conditional (a)?b: ", re.test("(a)?b", "b"), "\n")
io.write("\\d+: ", re.search("\\d+", "a12b"), "\n")
io.write("class [a-z]+: ", re.search("[a-z]+", "0abc"), "\n")
io.write("{2,3}: ", re.search("a{2,3}", "aaaa"), "\n")
io.write("escape \\.: ", re.search("\\.", "a.b"), "\n")
io.write("replace $1: ", re.replace("(a)(b)", "ab", "$2$1"), "\n")
io.write("split (a)(b): ", re.split("(a)(b)", "abab"), "\n")
io.write("groups on nested: ", re.groups("(a(b))", "ab"), "\n")
io.write("empty quantifier a{0}: ", re.search("a{0}b", "b"), "\n")
