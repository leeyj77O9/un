use io
use re

fn probe(name, pat, text)
    try
        io.write(name, " | ", re.search(pat, text), "\n")
    catch e
        io.write(name, " | ", `ERR {e}`, "\n")

fn rsplit(name, pat, text)
    try
        io.write(name, " | ", re.split(pat, text), "\n")
    catch e
        io.write(name, " | ", `ERR {e}`, "\n")

probe("s99", "(?i)AB", "AB")
probe("s100", "\\Z", "ab\n")
probe("s101", "a{3,2}", "aaa")
probe("s102", "(?<x>a)(?<y>b)\\k<z>", "ab")
probe("s103", "(?<x>a)(?<x>b)\\k<x>", "ab")
probe("s104", "(?<x>a)(?<x>b)\\k<x>", "abb")
probe("s105", "(?<n>a)\\k<n>x", "aax")
probe("s106", "(((a)))\\3", "aaaa")
probe("s107", "(?<x>a)cd\\k<x>", "acd")
probe("s108", "\\d\\k<x>", "1x")
probe("s109", "\\k<x>", "x")
probe("s110", "(?<x>a)x\\k<x>", "axx")
probe("s111", "((a)(b))x\\2", "aaxx")
probe("s112", "(a)x\\1", "axa")
probe("s113", "(a)(b)x\\3", "abx")
probe("s114", "a(?i)bc", "ABC")
probe("s115", "a(?i)bcd", "aBcd")
probe("s116", "(?x) a b", "ab")
probe("s117", "(?x)a[ ]b", "a b")
probe("s118", "(?<x>a)(?(x)b)", "ab")
probe("s119", "(?<x>a)(?(x)b)", "a")
probe("s120", "(?(x)b)", "b")
probe("s121", "(?<x>a)(?(x)b|c)", "ac")
probe("s122", "(?<x>a)(?(x)b|c)d", "acd")
probe("s123", "(?<x>a)(?(x)b|c)x", "axx")
probe("s124", "a\\1", "a")
probe("s125", "(?m)a$", "a\na")
probe("s126", "(?m)^a", "b\na")
probe("s127", "(?<x>a*)b", "aaab")
probe("s128", "(?<=a{2})b", "aab")
probe("s129", "(?<=ab)c", "abc")
probe("s130", "\\bfoo\\b", "x foo y")
probe("s131", "\\Bfoo", "xfoo")
probe("s132", "\\S+", "  ab  ")
probe("s133", "(?>a)ab", "aab")
probe("s134", "(?>a*)b", "aab")
probe("s135", "x(?>a*)ax", "aaax")

rsplit("p06", "a*", "ab")
rsplit("p07", "", "ab")
rsplit("p08", "a", "a")
rsplit("p09", "a", "ab")
rsplit("p10", "b", "ab")
rsplit("p11", "(a)(b)", "ab")
rsplit("p12", "\\b", "a a")
rsplit("p13", "(?:(a))b", "ab")
rsplit("p14", "(a)?b", "b")
rsplit("p15", "(a)(b)(c)", "abc")
rsplit("p16", ",", "a,,b")
