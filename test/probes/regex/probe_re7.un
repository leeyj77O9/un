use io
use re

fn probe(name, pat, text)
    try
        io.write(name, " [", pat, " on ", text, "] = ", re.search(pat, text), "\n")
    catch e
        io.write(name, " [", pat, " on ", text, "] = ERR ", e, "\n")

probe("s01", "\\b", "a a")
probe("s02", "\\Ba", "a a")
probe("s03", "\\ba", "a a")
probe("s04", "\\Aa", "ab")
probe("s05", "b\\z", "ab")
probe("s06", "b\\z", "abc")
probe("s07", "b\\Z", "ab\n")
probe("s08", "\\p{L}+", "abc")
probe("s09", "\\p{L}+", "1x")
probe("s10", "(?i)AB", "ab")
probe("s11", "a(?i)B", "aB")
probe("s12", "a(?i)B", "AB")
probe("s13", "(?m)^b", "a\nb")
probe("s14", "(?s)a.{2}", "a\nb")
probe("s15", "a.{2}", "a\nb")
probe("s16", "(?x)a b", "ab")
probe("s17", "b(?=a)", "ba")
probe("s18", "b(?!a)", "bc")
probe("s19", "a(?<=b)", "ba")
probe("s20", "(?<=a)b", "ab")
probe("s21", "a(?<!b)", "ba")
probe("s22", "(?>a*)ab", "aaab")
probe("s23", "a++b", "aaab")
probe("s24", "(a)\\1", "aa")
probe("s25", "(a)\\1", "ab")
probe("s26", "(?<x>a)\\k<x>", "aa")
probe("s27", "(?<x>a)\\k<y>", "aa")
probe("s28", "\\1", "aa")
probe("s29", "(a)?(b)\\2", "ab")
probe("s30", "(?<n>ab)", "ab")
probe("s31", "\\Qa.b*\\E", "a.b*")
probe("s32", "(?#comment)a", "a")
probe("s33", "a*", "aba")
probe("s34", "", "ab")
probe("s35", "a{2,1}", "aa")
probe("s36", "(", "a")
probe("s37", ")", "a")
probe("s38", "[", "a")
probe("s39", "[a-", "a")
probe("s40", "*a", "a")
probe("s41", "(?i", "a")
probe("s42", "(?<1>a)", "a")
probe("s43", "(?<ab-c>a)", "a")
probe("s44", "(?<a>b)cd", "abd")
