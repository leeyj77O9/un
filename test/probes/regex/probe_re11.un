use io
use re

fn probe(name, pat, text)
    try
        io.write(name, " | ", re.search(pat, text), "\n")
    catch e
        io.write(name, " | ", `ERR {e}`, "\n")

probe("q01", "(a)(b)\\3x", "abx")
probe("q02", "(?<x>a)\\k<y>x", "ax")
probe("q03", "a\\k<y>x", "axx")
probe("q04", "(a)x\\1y\\2", "axy")
probe("q05", "(?<x>a)(?<x>a)\\k<x>x", "aax")
probe("q06", "(?<x>a)(?<x>a)\\k<x>", "aa")
probe("q07", "(?<x>a)(?<x>a)x\\k<x>", "aaxa")
probe("q08", "(?<x>a)x\\k<x>", "axa")
probe("q09", "(?<x>a)\\k<x>bb", "abb")
probe("q10", "a\\1(bb)", "a")
probe("q11", "(a)(b)", "ab(")
probe("q12", "a\\1(", "a")
probe("q13", "(?<x>a)\\k<y>(", "a")
probe("q14", "(a)\\2(", "a")
probe("q15", "\\1(", "a")
probe("q16", "(?<x>a)\\k<z>(", "a")
probe("q17", "((a)(b))x\\2y", "aabx")
probe("q18", "(a)x\\1(y)\\2", "axay")
probe("q19", "(a)x\\1(y)\\2z", "axayz")
probe("q20", "(?<x>a)(?(x)b|c)x", "abx")
probe("q21", "(?<x>a)(?(x)b)x", "abx")
probe("q22", "(a)(?(1)b)", "ab")
probe("q23", "(a)(?(1)b)", "a")
probe("q24", "((a)(b))\\2", "aabb")
probe("q25", "(?:x)\\1", "x")
probe("q26", "(?<x>a)*\\k<x>", "aa")
probe("q27", "((a)\\1)+", "aaa")
probe("q28", "(?<x>a)x\\k<x>", "aaxa")
probe("q29", "(?<x>a)\\k<x>x", "aax")
probe("q30", "x(?<x>a)\\k<x>", "xaa")
