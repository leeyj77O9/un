use io
use re

fn probe(name, pat, text)
    try
        io.write(name, " | ", re.search(pat, text), "\n")
    catch e
        io.write(name, " | ", `ERR {e}`, "\n")

probe("x4", "\\x4", "a" + chr(4))
probe("x4z", "\\x4z", "a")
probe("x4g", "\\x4g", "a")
probe("xzzz", "\\xzzz", "a")
probe("x{41}", "\\x{41}", "a")
probe("u00z", "\\u00z", "a")
probe("u0041", "\\u0041", "A")
probe("uD83D", "\\uD83D", "a")
probe("x41", "\\x41", "A")
probe("xc1", "\\xc1", "A" + chr(4))
