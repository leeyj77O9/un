use io
use re

fn probe(name, pat, text)
    try
        io.write(name, " | ", `M {re.search(pat, text)}\n`)
    catch e
        io.write(name, " | ", `ERR {e}\n`)

fn esc(name, text)
    try
        io.write(name, " | ", `E {re.escape(text)}\n`)
    catch e
        io.write(name, " | ", `ERR {e}\n`)

probe("y01", "\pL", "a1")
probe("y02", "\p{IsAlpha}", "a1")
probe("y03", "\p{IsLatin1}", "a1")
probe("y04", "\p{Lu}", "aB")
probe("y05", "\p{Sm}+", "a+b")
probe("y06", "\p{Po}+", "a-.")
probe("y07", "[a[:alpha:]b]", "ab")
probe("y08", "[a[:alpha:]b]", ":")
probe("y09", "a{1,2}", "aaa")
probe("y10", "x)y", "x)y")
probe("y11", "(a)b(", "ab(")
probe("y12", "[^]", "a")
probe("y13", "a{2,}", "aaa")
probe("y14", "(?i:AB)", "ab")
probe("y15", "a{0,1}b", "b")
probe("y16", "(?x)a\nb", "ab")
probe("y17", "(a)\1\1", "aaa")
probe("y18", "((((((((((a))))))))))\10", "aaaaaaaaaa")
probe("y19", "(a)?(b)?\1\2", "ab")
probe("y20", "((a)|(b))\1", "ab")
probe("y21", "\d", "1")
probe("y22", "(?>a*)b", "aaab")
probe("y23", "a\b", "a")
probe("y24", "\Ba", "ab")
probe("y25", "\bx", "x")
probe("y26", "(a)(b)(c)(d)(e)(f)(g)(h)(i)(j)(k)\1", "abcdefghijk")
probe("y27", "(a)\1", "Aa")
probe("y28", "a{2,3}", "aaa")
probe("y29", "\p{L}", "1")
probe("y30", "[\p{L}x]", "x")

esc("z01", "a\nb")
esc("z02", "a\rb")
esc("z03", "a" + chr(12) + "b")
esc("z04", "a\\b")
esc("z05", "a$b")
esc("z06", "a%b")
