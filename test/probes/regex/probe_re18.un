use io
use re

fn B(s)
    -> chr(92) + s

fn probe(name, pat, text)
    try
        io.write(name, " | ", `M {re.search(pat, text)}\n`)
    catch e
        io.write(name, " | ", `ERR {e}\n`)

fn gp(name, pat, text)
    try
        io.write(name, " | ", `G {re.groups(pat, text)}\n`)
    catch e
        io.write(name, " | ", `ERR {e}\n`)

fn sp(name, pat, text)
    try
        io.write(name, " | ", `S {re.split(pat, text)}\n`)
    catch e
        io.write(name, " | ", `ERR {e}\n`)

fn ra(name, pat, text, sub)
    try
        io.write(name, " | ", `R {re.replace_all(pat, text, sub)}\n`)
    catch e
        io.write(name, " | ", `ERR {e}\n`)

probe("i01", "(a)(b)(c)(d)(e)(f)(g)(h)(i)(j)(k)" + B("11"), "aaaaaaaaaaa")
probe("i02", "(a)(b)(c)(d)(e)(f)(g)(h)(i)(j)" + B("10"), "aaaaaaaaaa")
probe("i03", "(a)(b)(c)(d)(e)(f)(g)(h)(i)(j)" + B("10"), "abcdefghijj")
probe("i04", "(a)(b)" + B("11"), "aa11")
probe("i05", "(a)" + B("11"), "aa11")

probe("j01", "[a-z&&[bc]]", "abc")
probe("j02", "[a-z&&[^b]]", "ab")
probe("j03", "[a&&b]", "b")
probe("j04", "[a-z&&b-d]", "bcd")
probe("j05", "[b-a]", "a")
probe("j06", "[" + B("n") + "]", chr(10))
probe("j07", "[" + B("t") + "]", chr(9))
probe("j08", "[^" + B("n") + "]+", "a" + chr(10) + "b")
probe("j09", "[" + B("a") + "]", chr(7))
probe("j10", "[" + B("f") + "]", chr(12))
probe("j11", "[" + B("v") + "]", chr(11))
probe("j12", B("a"), chr(7))
probe("j13", B("e"), chr(27))
probe("j14", B("f"), chr(12))
probe("j15", B("v"), chr(11))
probe("j16", B("cZ"), chr(26))
probe("j17", B("c1"), chr(17))
probe("j18", B("012"), chr(10))
probe("j19", B("08"), "8")
probe("j20", B("0"), "0")
probe("j21", B("x") + "4", "4")
probe("j22", B("x") + "4z", "4")
probe("j23", B("u") + "004", "A")
probe("j24", B("u") + "0z", "A")
probe("j25", B("x") + "4g", "4")
probe("j26", B("x") + "zzz", "z")

probe("k01", "(?<x>a)" + B("k'x'"), "aa")
probe("k02", "(?'x'a)" + B("k<x>"), "aa")
probe("k03", "(?'x'a)" + B("k'x'"), "aa")
probe("k04", "(?>a)(a)", "aa")
probe("k05", "(?<x>a)(?<y>b)", "ab")
probe("k06", "(?<x>a)(b)", "ab")
probe("k07", "(a|)", "b")
probe("k08", "()", "ab")
probe("k09", "(?:)", "a")
probe("k10", "x{0}y", "y")
probe("k11", "(a*)*", "aaa")
probe("k12", "((a)(b))(?(1)x)", "aax")
probe("k13", "((a))(?(1)x)", "ax")
probe("k14", "(?(1)a|b)", "b")
probe("k15", "(?<x>a)(?(x)cd)", "ae")
probe("k16", "(?i-m:abc)", "ABC")
probe("k17", "(?i-s:abc)", "ABC")
probe("k18", "a(?-i:a)A", "aA")
probe("k19", "(?n)abc", "abc")
probe("k20", "(?x)a b\tc", "abc")
probe("k21", "(?x)[ #]", " ")
probe("k22", "(?<=a|b)c", "bc")
probe("k23", "(?<![ab])c", "c")
probe("k24", "(?>a*)b", "aaab")
probe("k25", "(a$)", "a")
probe("k26", "a$", "a" + chr(10) + "b")
probe("k27", "^a", chr(10) + "ab")
probe("k28", "(?m)^a", chr(10) + "ab")
probe("k29", "(?m)a$", chr(10) + "ab")
probe("k30", "(?i)" + B("p") + "{Lu}b", "aBb")

gp("g10", "(?>a)(a)", "aa")
gp("g11", "(?<x>a)(?<y>b)", "ab")
gp("g12", "(?<x>a)(b)", "ab")
gp("g13", "(a|)", "b")
gp("g14", "()", "ab")
gp("g15", "(a)(b)(c)(d)(e)(f)(g)(h)(i)(j)", "abcdefghij")
gp("g16", "(a)?(b)?", "ab")

sp("p17", "(a)", "a")
sp("p18", "(a)", "aa")
sp("p19", "a|", "ab")
sp("p20", "", "")
sp("p21", "(a)(b)", "abab")

ra("q01", "(a)", "aabb", "$1$1")
ra("q02", "a", "aaa", "$0x")
ra("q03", "b", "abc", "$'")
ra("q04", "b", "abc", "$`")
