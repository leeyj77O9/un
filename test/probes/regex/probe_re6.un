use io
use re

io.write("replace $1: ", re.replace("(a)(b)", "ab", "$2$1"), "\n")
io.write("split (a)(b): ", re.split("(a)(b)", "abab"), "\n")
io.write("nested groups: ", re.groups("(a(b))", "ab"), "\n")
io.write("named groups: ", re.groups("(?<x>a)(?<y>b)", "ab"), "\n")
io.write("class neg: ", re.find_all("[^a]", "abc"), "\n")
io.write("escape: ", re.escape("a.b"), "\n")
io.write("range {2,3}: ", re.search("a{2,3}", "aaaa"), "\n")
io.write("group on find_all: ", re.find_all("(a)(b)", "abab"), "\n")
