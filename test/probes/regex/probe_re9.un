use io
use re

fn probe(name, pat, text)
    try
        io.write(name, " | ", re.search(pat, text), "\n")
    catch e
        io.write(name, " | ", `ERR {e}`, "\n")

fn rep(name, pat, text, sub)
    try
        io.write(name, " | ", re.replace(pat, text, sub), "\n")
    catch e
        io.write(name, " | ", `ERR {e}`, "\n")

fn rsplit(name, pat, text)
    try
        io.write(name, " | ", re.split(pat, text), "\n")
    catch e
        io.write(name, " | ", `ERR {e}`, "\n")

fn gp(name, pat, text)
    try
        io.write(name, " | ", re.groups(pat, text), "\n")
    catch e
        io.write(name, " | ", `ERR {e}`, "\n")

fn fa(name, pat, text)
    try
        io.write(name, " | ", re.find_all(pat, text), "\n")
    catch e
        io.write(name, " | ", `ERR {e}`, "\n")

probe("s67", "(a)?b\\1", "ab")
probe("s68", "(a)?b\\1", "b")
probe("s69", "(a)(b)\\3", "ab")
probe("s70", "((a)(b))\\2\\3", "aabb")
probe("s71", "(?<x>a)(?<x>b)", "ab")
probe("s72", "(?<x>a)\\k<x>", "a")
probe("s73", "(a\\1)b", "ab")
probe("s74", "(a)*\\1", "aa")
probe("s75", "((a)+)\\2", "aaa")
probe("s76", "(?i:a)b", "Ab")
probe("s77", "(?i:a)B", "aB")
probe("s78", "a(?i-:b)B", "aB")
probe("s79", "(?x)a  b", "ab")
probe("s80", "(?x)a #c\nb", "ab")
probe("s81", "((?'n'a))\\k<n>", "aa")
probe("s82", "(?<a-a>b)", "bb")
probe("s83", "(?'a'a)(?<a-a>b)", "ab")
probe("s84", "(?<x>a)(?<y>a)\\k<y>", "aa")
probe("s85", "(?>a*ab)", "aaab")
probe("s86", "(?:a*)ab", "aaab")
probe("s87", "a(?=b)cd", "abcd")
probe("s88", "a(?!b)cd", "accd")
probe("s89", "b(?<=a)", "ab")
probe("s90", "b(?<!a)", "cb")
probe("s91", "(?<=(a))b", "ab")
probe("s92", "(?<a)*b", "aaab")
probe("s93", "(?<=a*)b", "aaab")
probe("s94", "x(?<=a+)x", "aax")
probe("s95", "$", "ab")
probe("s96", "^", "")
probe("s97", "^a$", "a")
probe("s98", "a$", "a\n")

rep("r01", "(a)(b)", "ab", "$2$1")
rep("r02", "(a)(b)", "ab", "${1}${2}")
rep("r03", "a", "aba", "$$")
rep("r04", "a", "aba", "$&x")
rep("r05", "a", "aba", "$`x")
rep("r06", "a", "aba", "$'x")
rep("r07", "(a)(b)", "ab", "$+")
rep("r08", "a", "aba", "$1")
rep("r09", "b", "abc", "$&")
rep("r10", "a", "aaa", "x$1y")
rep("r11", "a", "aba", "$0x")
rep("r12", "a", "aba", "$x")
rep("r13", "b", "ab", "$1$2")

fa("f01", "a*", "aba")
fa("f02", "", "ab")
fa("f03", "(a)(b)", "abab")
fa("f04", "\\b", "a a")
fa("f05", "\\d", "a1b2")
fa("f06", "a", "")

gp("g01", "(a)(b)", "ab")
gp("g02", "(a(b))", "ab")
gp("g03", "(?<x>a)(?<y>b)", "ab")
gp("g04", "(a)?(b)", "b")
gp("g05", "a", "ab")

rsplit("p01", "(a)(b)", "abab")
rsplit("p02", "a", "bab")
rsplit("p03", "b", "")
rsplit("p04", "(?:(a))", "aa")
rsplit("p05", ",\\s*", "a, b,c")
