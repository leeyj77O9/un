use io
use re

io.write("1 | ", re.test("(?i)1x", "1X"), "\n")
io.write("2 | ", re.find_all("(?i)1", "1A1"), "\n")
io.write("3 | ", re.find_all("(?i) ", "a b"), "\n")
io.write("4 | ", re.find_all("(?i)\\p{Nd}", "a1A9"), "\n")
io.write("5 | ", re.find_all("(?i)[0-9]", "a1A9"), "\n")
io.write("6 | ", re.find_all("(?i)1{2,3}", "111A1"), "\n")
io.write("7 | ", re.find_all("a(?i)b", "AB"), "\n")
io.write("8 | ", re.find_all("(?i)1{2}", "11A1"), "\n")
io.write("9 | ", re.find_all("(?i)1*", "1A11"), "\n")
io.write("10 | ", re.find_all("(?i)1+", "1A11"), "\n")
