use io
use re

fn probe(name, pat, text)
    try
        io.write(name, " | ", re.search(pat, text), "\n")
    catch e
        io.write(name, " | ", `ERR {e}`, "\n")

probe("k01", "\\j", "j")
probe("k02", "\\y", "y")
probe("k03", "(?P<n>a)\\k<n>", "aa")
probe("k04", "(?P<n>a)(?P=n)", "aa")
probe("k05", "(?P<n>a)\\k<m>", "aa")
probe("k06", "(?'n'a)\\k<n>", "aa")
probe("k07", "(?i-x:a)b", "Ab")
probe("k08", "[[:alpha:]]", "a")
probe("k09", "(?i-x)a", "a")
probe("k10", "(?<-a>b)", "b")
probe("k11", "(?<x>a)(?<x-a>b)", "ab")
probe("k12", "(?<x>a)(?<x-a>b)", "a")
probe("k13", "a{2,3}b", "aaab")
probe("k14", "(?i)[a-z]", "A")
probe("k15", "(?i)[^a-z]", "A")
probe("k16", "(?m)b$", "b\nb")
probe("k17", "b$", "b\nb")
probe("k18", "(?s).{2}$", "ab")
probe("k19", "x{0}y", "y")
probe("k20", "(?x)a\rb", "ab")
probe("k21", "\\p{L}b", "Ab")
probe("k22", "[a-c-f]", "d")
probe("k23", "[\\n]", "a\nb")
probe("k24", "\\w\\b", "a a")
probe("k25", "\\Bx", "x")
probe("k26", "(?i)k", "K")
probe("k27", "(?i)K", "k")
probe("k28", "\\p{Lu}\\p{Ll}", "aB")
probe("k29", "(?<x>a)\\k<x>", "aA")
probe("k30", "(?x)a\\ b", "ab")
probe("k31", "(?i)(a)\\1", "aA")
probe("k32", "x(?i)yz", "xYZ")
probe("k33", "x(?i)y\\1", "xYx")
probe("k34", "(x)(?i)y\\1", "xYx")
probe("k35", "(?i)(x)y\\1", "Xyx")
