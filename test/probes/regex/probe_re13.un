use io
use re

fn probe(name, pat, text)
    try
        io.write(name, " | ", re.search(pat, text), "\n")
    catch e
        io.write(name, " | ", `ERR {e}`, "\n")

fn rep(name, pat, text, sub)
    try
        io.write(name, " | ", re.replace(pat, text, sub), "\n")
    catch e
        io.write(name, " | ", `ERR {e}`, "\n")

fn gp(name, pat, text)
    try
        io.write(name, " | ", re.groups(pat, text), "\n")
    catch e
        io.write(name, " | ", `ERR {e}`, "\n")

probe("h01", "\\0", "a")
probe("h02", "\\01", "a")
probe("h03", "\\8", "a")
probe("h04", "\\9", "a")
probe("h05", "(a)(b)(c)(d)(e)(f)(g)(h)(i)(j)\\10", "abcdefghij")
probe("h06", "(a)(b)\\10", "ab10")
probe("h07", "(a)(b)\\1x", "a1x")
probe("h08", "(a)(b)\\12", "ab12")
probe("h09", "\\N", "a\nb")
probe("h10", "\\f", "a")
probe("h11", "\\v", "a")
probe("h12", "\\a", "a")
probe("h13", "\\e", "a")
probe("h14", "\\x4", "a" + chr(4))
probe("h15", "\\xzz", "a")
probe("h16", "\\u00z", "a")
probe("h17", "(?x)a#b\nc", "ac")
probe("h18", "(?x)a[ab]b", "ab")
probe("h19", "x(?i:y)z", "xYz")
probe("h20", "(?i)abc", "aBc")
probe("h21", "((a)(b))(?(2)x)", "aax")
probe("h22", "((a)(b))(?(2)x)", "abx")
probe("h23", "(?<x>a)(?(x)cd)", "acd")
probe("h24", "(?<x>a)(?(x)cd)ef", "aeef")

rep("r14", "a", "a", "$_")
rep("r15", "(a)", "a", "$1$_")
rep("r16", "(a)(b)", "ab", "${x}")
rep("r17", "(?<x>a)", "a", "${x}")
rep("r18", "(?<x>a)", "a", "${x}y")
rep("r19", "(?<x>a)(?<y>b)", "ab", "${y}${x}")
rep("r20", "a", "a", "$")
rep("r21", "(a)(b)(c)(d)(e)(f)(g)(h)(i)(j)", "abcdefghij", "$10")
rep("r22", "(a)(b)", "ab", "$10")
rep("r23", "(a)(b)", "ab", "${1}")
rep("r24", "a", "aa", "$$x")
rep("r25", "a", "ab", "$&$'")

gp("g06", "((a)(b))x\\2", "aax")
gp("g07", "(?<x>a)(?<x>b)", "ab")
gp("g08", "(a)(?:b)(c)", "abc")
gp("g09", "(a)|b", "b")
