use io
use re

io.write("lookbehind (?<=a)b: ", re.search("(?<=a)b", "ab"), "\n")
io.write("neg lookahead a(?!c): ", re.search("a(?!c)", "ab"), "\n")
io.write("atomic (?>a*)ab: ", re.test("(?>a*)ab", "aaab"), "\n")
io.write("(?i)AB on ab: ", re.search("(?i)AB", "ab"), "\n")
io.write("(?m)^b: ", re.search("(?m)^b", "a\nb"), "\n")
io.write("(?s) on a newline: ", re.search("(?s)a.{2}", "a\nb"), "\n")
io.write("conditional (a)?b: ", re.test("(a)?b", "b"), "\n")
io.write("replace $1: ", re.replace("(a)(b)", "ab", "$2$1"), "\n")
io.write("split (a)(b): ", re.split("(a)(b)", "abab"), "\n")
io.write("nested groups: ", re.groups("(a(b))", "ab"), "\n")
io.write("empty quantifier a{0}: ", re.search("a{0}b", "b"), "\n")
io.write("anchor $: ", re.search("b$", "ab"), "\n")
io.write("class neg: ", re.find_all("[^a]", "abc"), "\n")
