use io
use re

io.write("named: ", re.groups("(?<x>a)(?<y>b)", "ab"), "\n")
io.write("backref: ", re.test("(a)\\1", "aa"), "\n")
io.write("lookahead: ", re.search("a(?=b)", "ab"), "\n")
io.write("non-greedy: ", re.search("a+?b", "aaab"), "\n")
io.write("word bound: ", re.search("\\ba", "a a"), "\n")
io.write("inline flag: ", re.test("(?i)A", "a"), "\n")
io.write("class neg: ", re.find_all("[^a]", "abc"), "\n")
io.write("range: ", re.search("a{2}", "aa"), "\n")
io.write("alt: ", re.search("cat|dog", "xdog"), "\n")
