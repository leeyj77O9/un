use io
use re

io.write("\\b: ", re.search("\\ba", "a a"), "\n")
io.write("\\B: ", re.search("\\Bb", "ab"), "\n")
io.write("(?i): ", re.search("(?i)AB", "ab"), "\n")
io.write("(?m): ", re.search("(?m)^b", "a\nb"), "\n")
io.write("(?s): ", re.search("(?s)a.{2}", "a\nb"), "\n")
io.write("(?=a): ", re.search("b(?=a)", "ba"), "\n")
io.write("(?!a): ", re.search("b(?!a)", "bc"), "\n")
io.write("(?<=b): ", re.search("a(?<=b)", "ba"), "\n")
io.write("(?<>a): ", re.search("a(?<>b)", "ab"), "\n")
