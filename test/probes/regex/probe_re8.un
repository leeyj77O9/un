use io
use re

fn probe(name, pat, text)
    try
        io.write(name, " | ", re.search(pat, text), "\n")
    catch e
        io.write(name, " | ", `ERR {e}`, "\n")

probe("s33", "a*", "aba")
probe("s34", "", "ab")
probe("s35", "a{2,1}", "aa")
probe("s36", "(", "a")
probe("s37", ")", "a")
probe("s38", "[", "a")
probe("s39", "[a-", "a")
probe("s40", "*a", "a")
probe("s41", "(?i", "a")
probe("s42", "(?<1>a)", "a")
probe("s43", "(?<ab-c>a)", "a")
probe("s44", "(?<a>b)cd", "abd")
probe("s45", "a++b", "aaab")
probe("s46", "a**", "aa")
probe("s47", "a{2}{3}", "aaaaa")
probe("s48", "a{0}b", "b")
probe("s49", "a\\p{L}b", "axb")
probe("s50", "\\p{Nd}+", "a12b")
probe("s51", "\\p{Lu}+", "aAbB")
probe("s52", "[\\p{L}]+", "a-b")
probe("s53", "(a)(b)\\1\\2", "abab")
probe("s54", "(?:(a)\\1)+", "aaa")
probe("s55", "(?<x>a)\\k<x>\\k<x>", "aaa")
probe("s56", "(?(1)x|y)", "x")
probe("s57", "(?(1)x|y)", "y")
probe("s58", "(?<x>a)(?(x)y)", "ay")
probe("s59", "(?<x>a)(?(x)y)x", "axx")
probe("s60", "\\k", "a")
probe("s61", "\\P{L}+", "1- ")
probe("s62", "\\d\\k<x>", "a")
probe("s63", "[a\\d]", "a1")
probe("s64", "[^\\d]", "a1")
probe("s65", "a{1,}", "aaa")
probe("s66", "a{,2}", "aa")
