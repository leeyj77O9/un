use io
use re

fn probe(name, pat, text)
    try
        io.write(name, " | ", re.search(pat, text), "\n")
    catch e
        io.write(name, " | ", `ERR {e}`, "\n")

probe("a{2b}", "a{2b}", "a{2b}")
probe("a{b}", "a{b}", "a{b}")
probe("a{2}", "a{2}", "aa")
probe("a{2,}", "a{2,}", "aaaa")
probe("a{2,3}", "a{2,3}", "aaa")
probe("a{}", "a{}", "a{}")
probe("a{,3}", "a{,3}", "aaa")
probe("a{2,3}x", "a{2,3}x", "aaax")
probe("*a", "*a", "*a")
probe("+a", "+a", "+a")
probe("?a", "?a", "?a")
probe("a{2}{3}", "a{2}{3}", "aaaaa")
probe("a++b", "a++b", "aaab")
probe("a**", "a**", "aa")
probe("a???", "a???", "a")
probe("a{2,1}", "a{2,1}", "a")
