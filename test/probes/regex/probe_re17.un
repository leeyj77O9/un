use io
use re

fn B(s)
    -> chr(92) + s

fn probe(name, pat, text)
    try
        io.write(name, " | ", `M {re.search(pat, text)}\n`)
    catch e
        io.write(name, " | ", `ERR {e}\n`)

fn fa(name, pat, text)
    try
        io.write(name, " | ", `F {re.find_all(pat, text)}\n`)
    catch e
        io.write(name, " | ", `ERR {e}\n`)

fn sp(name, pat, text)
    try
        io.write(name, " | ", `S {re.split(pat, text)}\n`)
    catch e
        io.write(name, " | ", `ERR {e}\n`)

fn rp(name, pat, text, sub)
    try
        io.write(name, " | ", `R {re.replace(pat, text, sub)}\n`)
    catch e
        io.write(name, " | ", `ERR {e}\n`)

probe("p01", B("pL"), "a1")
probe("p02", B("p{IsAlpha}"), "a1")
probe("p03", B("p{IsLatin1}"), "a1")
probe("p04", B("p{Lu}"), "aB")
probe("p05", B("p{Sm}+"), "a+b")
probe("p06", B("p{Po}+"), "a-.")
probe("p07", "[" + B("p{L}") + "]", "a1")
probe("p08", B("p{L}+"), "a1")
probe("p09", B("p{Nd}"), "a1")
probe("p10", B("p{Zs}"), "a b")
probe("p11", B("p{Lu}+"), "aBB")
probe("p12", B("p{Ll}"), "aB")
probe("p13", B("p{P}+"), "a-.")
probe("p14", B("p{IsGreek}"), "a")
probe("p15", B("p{IsControl}"), "a")
probe("p16", B("p{Lx}"), "a")
probe("p17", B("p{Ll") + "a", "a")
probe("p18", B("p{}"), "a")
probe("p19", "[" + B("p{L}") + "x]", "x")
probe("p20", B("p{L}"), "1")
probe("p21", B("p{Lu}"), "A")
probe("p22", B("p{L}") + "x", "ax")
probe("p23", B("p{Mn}"), "a")
probe("p24", B("p{Cf}"), "a")
probe("p25", B("p{Sm}"), "=")
probe("p26", B("p{S}"), "+")
probe("p27", B("p{L}") + B("p{Nd}"), "a1")
probe("p28", "(?i)" + B("p{Lu}"), "a")
probe("p29", B("p{Pc}"), "_")
probe("p30", B("p{IsLetter}"), "a")

probe("a01", "(a)" + B("1"), "aa")
probe("a02", "(a)" + B("1"), "Aa")
probe("a03", "(?i)(a)" + B("1"), "aA")
probe("a04", "(?<x>a)" + B("k<x>"), "aa")
probe("a05", "(a)" + B("1") + B("1"), "aaa")
probe("a06", "(a)(b)(c)(d)(e)(f)(g)(h)(i)(j)(k)" + B("11"), "abcdefghijk")
probe("a07", "(a)(b)(c)(d)(e)(f)(g)(h)(i)(j)" + B("10"), "abcdefghij")
probe("a08", "(a)(b)" + B("10"), "ab10")
probe("a09", "(a)(b)" + B("1x"), "a1x")
probe("a10", "(a)(b)" + B("12"), "ab12")
probe("a11", B("8"), "a")
probe("a12", "(a)" + B("2"), "aa")
probe("a13", "(a)" + B("1"), "a")
probe("a14", "(a)(?i:" + B("1") + ")", "aA")
probe("a15", "(?>(a))" + B("1"), "aa")
probe("a16", B("x") + "41", "A")
probe("a17", B("u") + "0041", "A")
probe("a18", B("cA"), chr(1))
probe("a19", B("01"), chr(1))
probe("a20", B("0"), chr(0))
probe("a21", B("x") + "{41}", "A")

probe("n01", B("b") + "x", "x")
probe("n02", "a" + B("b"), "a")
probe("n03", B("Ba"), "ab")
probe("n04", B("Aa"), "ab")
probe("n05", "b" + B("z"), "ab")
probe("n06", "b" + B("Z"), "ab" + chr(10))
probe("n07", B("Z"), "ab" + chr(10))
probe("n08", B("A"), "ab")
probe("n09", B("z"), "ab")

probe("c01", "[a" + B("d") + "]", "a1")
probe("c02", "[^" + B("d") + "]", "a1")
probe("c03", "[" + B("w") + "]", "_1")
probe("c04", "[" + B("s") + "]", " x")
probe("c05", "[a" + B("b") + "]", "a")
probe("c06", "[a" + B("Z") + "]", "aZ")
probe("c07", "[" + B("p{L}") + "]", "a1")
probe("c08", "[^" + B("p{L}") + "]", "1a")
probe("c09", B("Q") + "b" + B("E") + "+", "b")
probe("c10", "[^a]", "abc")
probe("c11", "[" + B("d") + "-z]", "a1")
probe("c12", "a" + B("b") + "c", "abc")

probe("l01", "(?<=" + B("d") + ")b", "a1b")
probe("l02", "(?<=" + B("d") + "+)b", "a11b")
probe("l03", "(?<!" + B("d") + ")b", "ab")
probe("l04", "(?=" + B("d") + ")1", "a1b")
probe("l05", "(?!" + B("d") + ")b", "ab")

fa("f01", "[" + "^a]", "abc")
fa("f02", B("d") + "+", "a1b2c3")
fa("f03", B("b"), "a a")
fa("f04", B("w") + "+", "a b_c")

sp("s01", B("d"), "a1b2")
sp("s02", B("b"), "ab")
sp("s03", "(a)" + B("1"), "aabb")

rp("r01", "(a)", "aa", "$1$1")
rp("r02", "(a)(b)", "ab", "$2$1$&")
rp("r03", "(?<x>a)", "aa", "${x}")
rp("r04", "a", "ab", "$0")
rp("r05", "(a)", "aa", "$1x")
