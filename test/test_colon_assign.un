use io

fn check(actual, expected, label)
    if actual != expected
        panic(`[FAIL] {label}: expected {expected}, got {actual}`)

# statement form and expression value
x := 10
check(x, 10, "x := 10")
check((y := 5), 5, "expression value")
check(y, 5, "expression assignment binds")

# usable inside larger expressions
check(1 + (n := 2), 3, "inside arithmetic")
check(n, 2, "arithmetic target")

# right-associative chain
a := b := c := 7
check(a, 7, "chain a")
check(b, 7, "chain b")
check(c, 7, "chain c")

# lower precedence than ternary
cond := true ? 1 : 2
check(cond, 1, "ternary on the right")
ok := false ? 1 : 2
check(ok, 2, "ternary false branch")

# function arguments
fn identity(value)
    -> value
passed := identity(arg := 42)
check(passed, 42, "argument value")
check(arg, 42, "argument target")

# conditions
flag := false
if (flag := true)
    check(flag, true, "if condition")
else
    panic("[FAIL] if condition did not run")

n := 3
while (n := n - 1) >= 0
    skip
check(n, -1, "while condition")

# loop body updates the outer binding
sum := 0
for v in [1, 2, 3]
    sum := sum + v
check(sum, 6, "for loop :=")

# return expression
fn make()
    -> result := 99
check(make(), 99, "return expression")

# property and index targets
class Box(v)
box := Box(1)
box.v := 5
check(box.v, 5, "property target")

lst := [1, 2, 3]
lst[1] := 9
check(lst[1], 9, "index target")

# destructuring target
(p, q) := (3, 4)
check(p, 3, "tuple target p")
check(q, 4, "tuple target q")

# colons in literals and slices are unaffected
d := {"key": 1}
check(d["key"], 1, "dict literal")
check([10, 20, 30][1:3], [20, 30], "slice")

# function scopes still shadow instead of mutating outer bindings
fn shadow()
    x := 123
    -> x
check(shadow(), 123, "shadow inner")
check(x, 10, "shadow outer unchanged")

io.write("all colon assignment tests passed!")
