# ---------- ?대줈? ----------
fn make_adder(n)
    fn add(x)
        -> x + n
    -> add
add5 = make_adder(5)
assert.assert_eq(add5(10), 15, "closure captures the parameter")

# ---------- ?μ떇 ----------
fn double(x)
    -> x * 2
fn deco(target)
    fn wrapped(x)
        -> target(x) * 3
    -> wrapped
@deco
fn decorated(x)
    -> x + 1
assert.assert_eq(decorated(5), 18, "decorator wraps the function")

# ---------- ?덉쇅 ?꾪뙆 ----------
fn may_fail(x)
    if x < 0
        -> throw("negative")
    -> x * 2
assert.assert_eq(may_fail(5)?, 10, "? returns the value on success")
assert.assert_err(fn() -> may_fail(-1)?, "negative")

v = none
assert.assert_eq(v?.value, none, "safe member access on none is none")
assert.assert_eq(v?.len(), none, "safe call on none is none")

# ---------- throw 怨꾩뿴 ----------
assert.assert_err(fn() -> throw("boom"), "boom")
assert.assert_err(fn() -> throw_if(true, "cond hit"), "cond hit")
assert.assert_eq(throw_if(false, "no"), none, "throw_if does nothing when the condition is false")
assert.assert_err(fn() -> throw_unless(false, "cond miss"), "cond miss")
assert.assert_eq(throw_unless(true, "no"), none, "throw_unless does nothing when the condition is true")

# ---------- 諛섑솚媛믪씠 ?녿뒗 ?⑥닔 ----------
fn no_return()
    unused = 1
assert.assert_eq(no_return(), none, "function without a return yields none")

fn none_annotated() -> none
    unused = 2
assert.assert_eq(none_annotated(), none, "none return type annotation parses")


fn ident_list(xs)
    -> xs
assert.assert_eq(len(ident_list([7, 8, 9])), 3, 'identity list round-trips')


fn add(a: int, b: int) -> int
    -> a + b
assert.assert_eq(add(1, 2), 3, "typed return with int params runs")

# ---------- function return type annotations ----------
fn typed_identity(xs) -> list[int]
    -> xs
assert.assert_eq(len(typed_identity([1, 2, 3])), 3, 'fn parameter list typed annotation parses')
fn typed_count(n: int) -> int
    if n <= 0
        -> 0
    -> n + typed_count(n - 1)
assert.assert_eq(typed_count(3), 6, 'typed return function runs')
fn typed_pair(a: int, b: int) -> tuple[int, str]
    -> (a, 'b')
assert.assert_eq(typed_pair(1, 2)[1], 'b', 'typed return with tuple')
fn bool_fix() -> bool
    -> true
assert.assert_eq(bool_fix(), true, 'bool return type annotation')
fn union_pick(x: int) -> int | str
    if x < 0
        -> x
    -> 'pos'
assert.assert_eq(union_pick(-5), -5, 'union return type accepts int')
assert.assert_eq(union_pick(5), 'pos', 'union return type accepts str')
assert.summary()
