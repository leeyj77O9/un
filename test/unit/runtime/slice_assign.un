use io
use iter
use test.assert as assert

# ============================================================
# slice assignment: replace a range with all elements of an iterable
# ============================================================

# 1. 중간 구간 교체
a = [1, 2, 3, 4, 5]
a[1:3] = [10, 20]
assert.assert_eq(a, [1, 10, 20, 4, 5], "replace middle range")

# 2. 동일한 크기의 구간 교체
a = [1, 2, 3, 4, 5]
a[1:3] = [9, 8]
assert.assert_eq(a, [1, 9, 8, 4, 5], "same-size range replacement")

# 3. 더 큰 Iterable로 교체
a = [1, 2, 3, 4, 5]
a[1:2] = [7, 8, 9]
assert.assert_eq(a, [1, 7, 8, 9, 3, 4, 5], "larger iterable grows the list")

# 4. 더 작은 Iterable로 교체
a = [1, 2, 3, 4, 5]
a[1:4] = [10, 20]
assert.assert_eq(a, [1, 10, 20, 5], "smaller iterable shrinks the list")

# 5. 빈 구간에 삽입
a = [1, 2, 3, 7, 8]
b = [4, 5, 6]
a[3:3] = b
assert.assert_eq(a, [1, 2, 3, 4, 5, 6, 7, 8], "insert into an empty range")

# 6. 리스트 맨 앞에 삽입
a = [1, 2, 3]
a[0:0] = [9]
assert.assert_eq(a, [9, 1, 2, 3], "insert at the front")

# 7. 리스트 맨 뒤에 삽입
a = [1, 2, 3]
a[3:3] = [9]
assert.assert_eq(a, [1, 2, 3, 9], "append at the tail")

# 8. 전체 리스트 교체
a = [1, 2, 3]
a[:] = [7, 8]
assert.assert_eq(a, [7, 8], "replace the whole list")

# 9. 빈 리스트에 삽입
a = []
a[0:0] = [1, 2]
assert.assert_eq(a, [1, 2], "insert into an empty list")

# 10. 빈 Iterable로 삭제
a = [1, 2, 3, 4, 5]
a[1:4] = []
assert.assert_eq(a, [1, 5], "empty iterable deletes the range")

# 11. 음수 인덱스
a = [1, 2, 3, 4, 5]
a[-4:-2] = [9]
assert.assert_eq(a, [1, 9, 4, 5], "negative bounds")

# 12. 생략된 시작 및 종료 인덱스
a = [1, 2, 3, 4, 5]
a[:2] = [9]
assert.assert_eq(a, [9, 3, 4, 5], "omitted start bound")
a = [1, 2, 3, 4, 5]
a[3:] = [8]
assert.assert_eq(a, [1, 2, 3, 8], "omitted end bound")

# 13. RHS가 원본 리스트와 동일한 객체인 경우
a = [1, 2, 3, 4, 5]
a[1:3] = a
assert.assert_eq(a, [1, 1, 2, 3, 4, 5, 4, 5], "self assignment snapshots the RHS first")

# 14. RHS가 일반 Iterable인 경우
a = [1, 2, 3, 4, 5]
a[1:3] = iter.range(10, 12)
assert.assert_eq(a, [1, 10, 11, 4, 5], "iterator RHS")
a = [1, 2, 3, 4, 5]
a[1:3] = (20, 30)
assert.assert_eq(a, [1, 20, 30, 4, 5], "tuple RHS")
s = ['a', 'b', 'c', 'd', 'e']
s[1:3] = 'xy'
assert.assert_eq(s, ['a', 'x', 'y', 'd', 'e'], "str RHS yields character elements")

# 객체 정체성 유지: 별도 참조도 같은 변경을 봐야 한다
a = [1, 2, 3, 4]
alias = a
a[1:3] = [7]
assert.assert_eq(alias, [1, 7, 4], "slice assignment keeps list identity")

# 확장 슬라이스: 선택된 위치를 정확히 같은 개수로 교체
a = [1, 2, 3, 4, 5]
a[::2] = [9, 20, 30]
assert.assert_eq(a, [9, 2, 20, 4, 30], "step slice replaces selected positions")
a = [1, 2, 3, 4, 5]
a[::-1] = [9, 8, 7, 6, 5]
assert.assert_eq(a, [5, 6, 7, 8, 9], "negative step reverses the assigned values")

# 경계를 i64로 유지: i32 범위를 넘어도 읽기 슬라이스와 동일하게 클램프
a = [1, 2, 3]
a[10000000000:20000000000] = [9]
assert.assert_eq(a, [1, 2, 3, 9], "64-bit bounds clamp to the tail")

# 15. 기존 슬라이싱 및 인덱스 할당 회귀
sl = [1, 2, 3, 4]
assert.assert_eq(sl[1:3], [2, 3], "slice read still works")
assert.assert_eq(sl[::-1], [4, 3, 2, 1], "stepped slice read still works")
sl[1] = 99
assert.assert_eq(sl, [1, 99, 3, 4], "index assignment still works")

assert.summary()
