use io
use test.assert as assert

# compound assignment re-evaluates the receiver or subscript
# (`make().v += 10` used to call make() twice — once for the load, once for
# the store — and the store landed on a throwaway object)

counter = list()
fn make()
    counter.add(1)
    -> Foo(1)

class Foo(v)

mk = make()
mk.v += 10
assert.assert_eq(mk.v, 11, "compound assignment stores through the same receiver")
assert.assert_eq(len(counter), 1, "make() was called exactly once")

# subscript case: a[g()] += n must evaluate g() once
calls = list()
fn key_of(n)
    calls.add(n)
    -> 0

a = [1, 2, 3]
a[key_of(1)] += 100
assert.assert_eq(a[0], 101, "compound subscript addition works")
assert.assert_eq(len(calls), 1, "the subscript was evaluated exactly once")

# index compound with a nested expression (still evaluates the key once)
a[0 + 0] *= 3
assert.assert_eq(a[0], 303, "compound with expression index")

# compound on a plain local variable (fast path, must stay correct)
x = 7
x *= 6
assert.assert_eq(x, 42, "compound on a plain local")

# typed compound assignment (`x: int += 1`) must reach codegen
fn bump_typed()
    y: int := 1
    y: int += 2
    y: int *= 3
    -> y
assert.assert_eq(bump_typed(), 9, "typed compound assignment works inside functions")

fn typed_prop_bump()
    self_v := Foo(1)
    self_v.v: int += 10
    -> self_v.v
assert.assert_eq(typed_prop_bump(), 11, "typed property compound assignment works")

# typed compound at module level
w: int := 10
w: int += 5
w: int *= 2
assert.assert_eq(w, 30, "typed compound assignment works at module level")

assert.summary()
