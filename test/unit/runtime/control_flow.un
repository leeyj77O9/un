use io
use iter
use test.assert as assert

# ============================================================
# 제어문 - if/elif/else, for/while, break/skip, 중첩, match, defer
# 실행: Un.exe run test/unit/runtime/control_flow.un  (C:\dev\un 에서)
# ============================================================

# ---------- 조건 ----------
fn classify(n)
    if n < 0
        -> "neg"
    elif n == 0
        -> "zero"
    else
        -> "pos"
assert.assert_eq(classify(-1), "neg", "if branch")
assert.assert_eq(classify(0), "zero", "elif branch")
assert.assert_eq(classify(1), "pos", "else branch")

# ---------- for ----------
out = []
for i in iter.range(0, 5)
    out.add(i)
assert.assert_eq(out, [0, 1, 2, 3, 4], "for collects every element")

out_skip = []
for i in iter.range(0, 5)
    if i == 2
        skip
    out_skip.add(i)
assert.assert_eq(out_skip, [0, 1, 3, 4], "skip continues the loop and skips the rest of that iteration")

out_break = []
for i in iter.range(0, 10)
    if i == 3
        break
    out_break.add(i)
assert.assert_eq(out_break, [0, 1, 2], "break exits the loop")

# ---------- 전역 if ----------
flag = "unset"
if 10 > 5
    flag = "set"
else
    flag = "other"
assert.assert_eq(flag, "set", "top level if takes the true branch")

flag2 = "unset"
if 10 < 5
    flag2 = "set"
elif 10 == 5
    flag2 = "mid"
else
    flag2 = "other"
assert.assert_eq(flag2, "other", "top level if falls to the else branch")

# ---------- 빈 집합 ----------
empty_out = []
for e in []
    empty_out.add(e)
assert.assert_eq(empty_out, [], "for over an empty list runs no body")

# ---------- 중첩 break은 안쪽 루프만 빠져나간다 ----------
inner_out = []
outer_out = []
for a in [1, 2]
    for b in [1, 2, 3]
        if b == 2
            break
        inner_out.add(b)
    outer_out.add(a)
assert.assert_eq(inner_out, [1, 1], "nested break stops only the inner loop")
assert.assert_eq(outer_out, [1, 2], "outer loop continues after the inner break")

# ---------- while ----------
n = 0
while n < 3
    n += 1
assert.assert_eq(n, 3, "while increments until the condition is false")

while_out = []
m = 0
while true
    m += 1
    if m > 2
        break
    while_out.add(m)
assert.assert_eq(while_out, [1, 2], "while with break")

while_skip = []
k = 0
while k < 5
    k += 1
    if k == 2
        skip
    while_skip.add(k)
assert.assert_eq(while_skip, [1, 3, 4, 5], "while with skip")

zero_loop = []
z = 0
while z < 0
    z += 1
assert.assert_eq(zero_loop, [], "while with a false condition runs no body")

# ---------- match ----------
match_out = []
for v in iter.range(1, 4)
    r = match v { 1 -> "one", 2 -> "two", _ -> "many" }
    match_out.add(r)
assert.assert_eq(match_out, ["one", "two", "many"], "match inside a loop")

assert.assert_eq(match "x" { "x" -> "hit", _ -> "miss" }, "hit", "match string pattern")
assert.assert_eq(match none { none -> "none hit", _ -> "miss" }, "none hit", "match none pattern")
assert.assert_eq(match 5 { _ -> "default" }, "default", "match falls back to the wildcard")

# ---------- defer는 후입선출 ----------
order = []
fn deferred()
    defer order.add("a")
    defer order.add("b")
    order.add("body")
deferred()
assert.assert_eq(order, ["body", "b", "a"], "defer runs in reverse order at scope exit")

defer_nested = []
fn inner_defer()
    defer defer_nested.add("inner")
    defer_nested.add("inner body")
fn outer_defer()
    defer defer_nested.add("outer")
    inner_defer()
outer_defer()
assert.assert_eq(defer_nested, ["inner body", "inner", "outer"], "defer is scoped to its function")

# ---------- try / finally ----------
both = []
try
    both.add("body")
finally
    both.add("finally")
assert.assert_eq(both, ["body", "finally"], "finally runs after the body")

both2 = []
try
    both2.add("before")
    z2 = 1 / 0
    both2.add("after")
catch err_cf1
    both2.add("caught")
finally
    both2.add("finally")
assert.assert_eq(both2, ["before", "caught", "finally"], "finally runs on the error path too")

# ---------- 루프 안의 ->는 함수를 빠져나간다 ----------
fn first_even(xs)
    for x in xs
        if x % 2 == 0
            -> x
    -> 0
assert.assert_eq(first_even([1, 3, 4, 5]), 4, "-> inside a for body returns from the function")
assert.assert_eq(first_even([1, 3, 5]), 0, "the fallback after the loop runs when nothing matched")

fn first_over(xs, n)
    i = 0
    while i < len(xs)
        if xs[i] > n
            -> i
        i += 1
    -> -1
assert.assert_eq(first_over([1, 2, 8], 5), 2, "-> inside a while body returns from the function")
assert.assert_eq(first_over([1, 2], 5), -1, "the loop end is reached when nothing matched")

fn nested_find(grid, target)
    for row in grid
        for cell in row
            if cell == target
                -> (row, cell)
    -> none
assert.assert_eq(nested_find([[1, 2], [3, 4]], 3), ([3, 4], 3), "-> in the innermost loop returns from the function")

fn deferred_return(xs)
    defer marks.add("exit")
    for x in xs
        if x == 2
            -> x
    -> 0
marks = []
assert.assert_eq(deferred_return([1, 2, 3]), 2, "the function returns from inside the loop")
assert.assert_eq(marks, ["exit"], "defer runs when -> leaves the loop")

fn try_return(xs)
    for x in xs
        try
            if x == 2
                -> x
        finally
            fin.add("fin")
    -> 0
fin = []
assert.assert_eq(try_return([1, 2, 3]), 2, "-> inside try returns from the function")
assert.assert_eq(fin, ["fin", "fin"], "finally runs for each iteration before the return")

assert.summary()
