use io
use ws
use test.assert as assert

# ============================================================
# ws - web_socket의 인자 검증 경로 (러너에는 WS 서버가 없으므로
# 검증 가능한 경로와 127.0.0.1:1만 사용한다)
# 실행: Un.exe run test/unit/native/ws.un  (C:\dev\un 에서)
# ============================================================

# ---------- connect 인자 검증 ----------
assert.assert_err_eq(fn() -> ws.connect(1), "error: expected value is string", "connect validates url type")
assert.assert_err_eq(fn() -> ws.connect(true), "error: expected value is string", "connect validates bool url")

# ---------- 연결 거부 ----------
assert.assert_err(fn() -> ws.connect("ws://127.0.0.1:1/socket"), "connection refused returns an error")
assert.assert_err(fn() -> ws.connect("not-a-uri"), "invalid uri returns an error")

assert.summary()
