use io
use time

# int_ops의 compile-mode 대응 벤치: bench.harness/assert 없이
# for 1..n + 정수 산술만 사용 (plain un build 가능).
# 7회 실행 후 회당 ms 출력.

fn int_ops(n: int) -> int
    total = 0
    for i in 1..n + 1
        total += (i * 1103515245 + 12345) % 10007
        total += (i * 7) // 3
        total += i & 255
        total += i ^ 0x5a5a
    -> total

fn main() -> int
    start = time.monotonic()
    r = 0
    while r < 7
        int_ops(1000000)
        r += 1
    io.write((time.monotonic() - start) * 1000.0 / 7.0)
    -> 0

main()
