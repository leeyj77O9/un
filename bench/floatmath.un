use io
use iter
use math
use bench.harness as bench
use test.assert as assert

# ============================================================
# 부동소수점 수학 - sin(1..20000)의 합 (math.sin 네이티브 호출)
# Node.js 벤치마크: bench/node/floatmath.mjs (같은 알고리즘, 같은 검증)
# 실행: Un.exe run bench/floatmath.un  (C:\dev\un 에서)
# ============================================================

fn sin_sum(n)
    total = 0.0
    for i in iter.range(1, n + 1)
        total += math.sin(i)
    -> total

# ---------- 검증 ----------
# libm 구현 차이로 하위 비트는 달라질 수 있어서 절대 오차 1e-9로 비교한다.
assert.assert_close(sin_sum(20000), 0.461960217373362, 1e-9, "sin(1..20000) sum")
assert.assert_close(sin_sum(10), 1.4111883712180104, 1e-12, "sin(1..10) sum")

# ---------- 측정 ----------
# 한 번의 sin_sum = math.sin 20000회 호출 + f64 덧셈 20000회
bench.measure("sin20000", fn(n) -> sin_sum(20000), 20000, 7, 2)

assert.summary()
