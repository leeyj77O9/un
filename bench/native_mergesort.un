use io
use time
use iter

# mergesort1000의 compile-mode 대응: slice 대신 (lo, hi) 범위와 iter.array 사용.
fn lcg(n: int, seed: int) -> list[int]
    xs: list[int] = [0]
    s = seed
    for i in 0..n
        s = (s * 1103515245 + 12345) % 100000
        if i == 0
            xs[0] = s
        else
            xs.add(s)
    -> xs

fn merge(a: list[int], b: list[int]) -> list[int]
    out = iter.array(0, len(a) + len(b))
    i = 0
    j = 0
    k = 0
    while i < len(a)
        if j >= len(b)
            break
        if a[i] <= b[j]
            out[k] = a[i]
            i += 1
        else
            out[k] = b[j]
            j += 1
        k += 1
    while i < len(a)
        out[k] = a[i]
        i += 1
        k += 1
    while j < len(b)
        out[k] = b[j]
        j += 1
        k += 1
    -> out

fn sub(xs: list[int], lo: int, hi: int) -> list[int]
    out = iter.array(0, hi - lo)
    k = 0
    for i in lo..hi
        out[k] = xs[i]
        k += 1
    -> out

fn msort(xs: list[int], lo: int, hi: int) -> list[int]
    if hi - lo <= 1
        -> sub(xs, lo, hi)
    mid = lo + (hi - lo) // 2
    -> merge(msort(xs, lo, mid), msort(xs, mid, hi))

fn main() -> int
    data = lcg(1000, 7)
    start = time.monotonic()
    r = 0
    while r < 7
        msort(data, 0, len(data))
        r += 1
    io.write((time.monotonic() - start) * 1000.0 / 7.0)
    -> 0

main()
