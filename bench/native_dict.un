use io
use time

# dict5000의 compile-mode 대응: core subset이 dict[int, int]를 지원하므로
# VM 경로(bench/dict.un)와 동일한 정수 키를 그대로 사용한다.
fn dict_work(n: int) -> int
    d: dict[int, int] = {0: 0}
    for i in 0..n
        d[i * 2] = i
    total = 0
    for i in 0..n
        total += d[i * 2]
    -> total

fn main() -> int
    start = time.monotonic()
    r = 0
    while r < 7
        dict_work(5000)
        r += 1
    io.write((time.monotonic() - start) * 1000.0 / 7.0)
    -> 0

main()
