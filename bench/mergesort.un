use io
use iter
use bench.harness as bench
use test.assert as assert

# ============================================================
# 머지 정렬 - LCG로 만든 1000개 정수 정렬
# Node.js 벤치마크: bench/node/mergesort.mjs (같은 알고리즘, 같은 입력, 같은 검증)
# Python 벤치마크: bench/python/mergesort.py (같은 알고리즘, 같은 입력, 같은 검증)
# ============================================================

fn lcg(n, seed)
    xs = []
    s = seed
    for i in iter.range(0, n)
        s = (s * 1103515245 + 12345) % 100000
        xs.add(s)
    -> xs

fn merge(a, b)
    out = []
    i = 0
    j = 0
    while i < len(a) and j < len(b)
        if a[i] <= b[j]
            out.add(a[i])
            i += 1
        else
            out.add(b[j])
            j += 1
    while i < len(a)
        out.add(a[i])
        i += 1
    while j < len(b)
        out.add(b[j])
        j += 1
    -> out

fn mergesort(xs)
    if len(xs) <= 1
        -> xs
    mid = len(xs) // 2
    -> merge(mergesort(xs[:mid]), mergesort(xs[mid:]))

fn data_sum(xs)
    t = 0
    for x in xs
        t += x
    -> t

data = lcg(1000, 7)
ref = []
for x in data
    ref.add(x)
ref.sort()
out = mergesort(data)
assert.assert_eq(len(out), 1000, "mergesort keeps every element")
assert.assert_eq(out, ref, "mergesort output equals the sorted reference")
assert.assert_eq(data_sum(out), data_sum(data), "mergesort preserves the sum")

bench.measure("mergesort1000", fn(n) -> mergesort(data), 1000, 7, 2)

assert.summary()
