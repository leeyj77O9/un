use io
use time
use math

# sin20000의 compile-mode 대응: math.sin intrinsic + f64 누산.
fn sin_sum(n: int) -> float
    total = 0.0
    for i in 1..n + 1
        total += math.sin(i)
    -> total

fn main() -> int
    start = time.monotonic()
    r = 0
    while r < 700
        sin_sum(20000)
        r += 1
    io.write((time.monotonic() - start) * 1000.0 / 700.0)
    -> 0

main()
