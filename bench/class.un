use io
use iter
use bench.harness as bench
use test.assert as assert

# ============================================================
# 클래스 - 1000개 인스턴스를 만들고 메서드 합
# Node.js 벤치마크: bench/node/class.mjs (같은 알고리즘, 같은 검증)
# 실행: Un.exe run bench/class.un  (C:\dev\un 에서)
# ============================================================

class Point
    fn __init__(x, y)
        self.x = x
        self.y = y
    fn norm()
        -> self.x * self.x + self.y * self.y

fn class_work(n)
    total = 0
    for i in iter.range(0, n)
        p = Point(i, i + 1)
        total += p.norm()
    -> total

# ---------- 검증 ----------
# sum(i^2 + (i+1)^2) = 2*sum(i^2) + 2*sum(i) + n
assert.assert_eq(class_work(3), 19, "class_work(3)")
assert.assert_eq(class_work(1000), 666667000, "class_work(1000)")

# ---------- 측정 ----------
bench.measure("class1000", fn(n) -> class_work(1000), 1000, 7, 2)

assert.summary()
