use io
use iter
use bench.harness as bench
use test.assert as assert

# ============================================================
# 행렬 곱 - 48x48 정수 행렬 곱셈 후 전체 합 검증
# Node.js 벤치마크: bench/node/matrix.mjs (같은 알고리즘, 같은 검증)
# 실행: Un.exe run bench/matrix.un  (C:\dev\un 에서)
# ============================================================

fn mat_mul(a, b)
    n = len(a)
    out = []
    for i in iter.range(0, n)
        row = []
        for j in iter.range(0, n)
            s = 0
            for k in iter.range(0, n)
                s += a[i][k] * b[k][j]
            row.add(s)
        out.add(row)
    -> out

fn checksum(m)
    t = 0
    for row in m
        for v in row
            t += v
    -> t

# ---------- 입력 ----------
# a[i][j] = (i*31 + j*17 + 7) % 13, b[i][j] = (i*11 + j*5 + 3) % 11
n = 48
a = []
b = []
for i in iter.range(0, n)
    ra = []
    rb = []
    for j in iter.range(0, n)
        ra.add((i * 31 + j * 17 + 7) % 13)
        rb.add((i * 11 + j * 5 + 3) % 11)
    a.add(ra)
    b.add(rb)

# ---------- 검증 ----------
ident = [[1, 0], [0, 1]]
small = [[1, 2], [3, 4]]
assert.assert_eq(checksum(mat_mul(small, small)), 54, "2x2 product checksum")
assert.assert_eq(mat_mul(small, ident), small, "multiplying by the identity keeps the matrix")
assert.assert_eq(checksum(mat_mul(a, b)), 3319440, "48x48 product checksum")

# ---------- 측정 ----------
# 한 번의 mat_mul = 48^3 = 110592번의 곱셈/덧셈 + 48*48개 원소 쓰기
bench.measure("matrix48", fn(x) -> checksum(mat_mul(a, b)), 110592, 7, 2)

assert.summary()
